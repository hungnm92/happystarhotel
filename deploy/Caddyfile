# Caddy trên VPS Oracle — chép vào /etc/caddy/Caddyfile (xem deploy/README.md)
# Caddy tự xin và gia hạn chứng chỉ HTTPS khi DNS đã trỏ về máy này.

(site) {
	root * /var/www/happystar
	encode zstd gzip
	file_server

	handle_errors {
		@notfound expression {err.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# File trong /_astro/ có mã hash trong tên, cache lâu được
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}

happystarhotelnhatrang.com {
	import site
}

www.happystarhotelnhatrang.com {
	redir https://happystarhotelnhatrang.com{uri} permanent
}

# Xem thử bằng IP trước khi trỏ DNS. Xoá khối này sau khi chuyển DNS xong.
http://161.118.227.225 {
	import site
	header X-Robots-Tag "noindex, nofollow"
}
