---
import { Image } from 'astro:assets';
import { asset } from '../lib/images';
import type { Dict } from '../i18n/vi';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section class="section intro">
  <div class="container grid">
    <Image
      class="photo"
      src={asset('hotel/lobby.jpg')}
      alt={t.intro.lobbyAlt}
      widths={[480, 800, 1200]}
      sizes="(max-width: 860px) 100vw, 50vw"
    />
    <div class="copy">
      <h2>{t.intro.title}</h2>
      <p>{t.intro.body}</p>
      <dl class="facts">
        {
          t.intro.facts.map((f) => (
            <div>
              <dt>{f.value}</dt>
              <dd>{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .copy {
    display: grid;
    gap: 1.25rem;
  }

  .copy > p {
    color: var(--muted);
    max-width: 36rem;
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0.5rem 0 0;
    border-top: 1px solid var(--line);
  }

  .facts div {
    padding: 1rem 0.75rem 1rem 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-size: var(--step-2);
    font-weight: 900;
    color: var(--sea);
    line-height: 1.1;
  }

  dd {
    margin: 0.2rem 0 0;
    font-size: var(--step--1);
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
