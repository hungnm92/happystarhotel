---
import Icon from './Icon.astro';
import { links } from '../data/contact';
import type { Dict } from '../i18n/vi';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const zalo = { key: 'zalo', href: links.zalo, label: t.mobileBar.zalo, icon: 'zalo' as const };
const whatsapp = {
  key: 'whatsapp',
  href: links.whatsapp(t.contact.whatsappText),
  label: t.mobileBar.whatsapp,
  icon: 'whatsapp' as const,
};
const messaging = t.primaryChannel === 'zalo' ? [zalo, whatsapp] : [whatsapp, zalo];
---

<nav class="mobile-bar" aria-label={t.nav.contact}>
  <a href={links.tel} data-cta="bar-call"><Icon name="phone" size={20} />{t.mobileBar.call}</a>
  {
    messaging.map((m, i) => (
      <a class:list={{ primary: i === 0 }} href={m.href} target="_blank" rel="nofollow noopener" data-cta={`bar-${m.key}`}>
        <Icon name={m.icon} size={22} />
        {m.label}
      </a>
    ))
  }
</nav>

<style>
  .mobile-bar {
    display: none;
  }

  @media (max-width: 760px) {
    .mobile-bar {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 50;
      display: grid;
      grid-template-columns: 1fr 1.4fr 1fr;
      gap: 6px;
      padding: 8px 8px calc(8px + env(safe-area-inset-bottom));
      background: rgb(255 255 255 / 0.97);
      border-top: 1px solid var(--line);
      box-shadow: 0 -8px 24px -12px rgb(10 46 99 / 0.3);
    }

    a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      min-height: 48px;
      border-radius: 12px;
      background: var(--foam);
      color: var(--ink);
      font-weight: 800;
      text-decoration: none;
    }

    a.primary {
      background: var(--sun);
    }
  }
</style>
