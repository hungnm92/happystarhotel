---
import { Image, getImage } from 'astro:assets';
import { asset } from '../lib/images';
import { galleryImages } from '../data/rooms';
import type { Dict } from '../i18n/vi';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const full = await Promise.all(
  galleryImages.map((p) => getImage({ src: asset(p), width: 1600, format: 'webp' })),
);
const gallery = JSON.stringify(full.map((img) => ({ src: img.src, alt: 'Happy Star Hotel' })));
---

<section class="section" aria-labelledby="gallery-title">
  <div class="container">
    <div class="section-head">
      <h2 id="gallery-title">{t.gallery.title}</h2>
    </div>
    <div class="mosaic" data-gallery={gallery}>
      {
        galleryImages.map((p, i) => (
          <button type="button" data-index={i} aria-label={`${t.gallery.open} ${i + 1}`}>
            <Image src={asset(p)} alt="" widths={[400, 700]} sizes="(max-width: 700px) 50vw, 25vw" />
          </button>
        ))
      }
    </div>
  </div>
</section>

<style>
  .mosaic {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: clamp(120px, 16vw, 210px);
    gap: 8px;
  }

  button {
    padding: 0;
    border: 0;
    background: var(--foam);
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: zoom-in;
  }

  button img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  button:hover img {
    filter: brightness(1.06);
  }

  /* Nhịp ảnh lớn / nhỏ */
  button:nth-child(1) {
    grid-column: span 2;
    grid-row: span 2;
  }

  button:nth-child(6) {
    grid-column: span 2;
  }

  @media (max-width: 700px) {
    .mosaic {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 140px;
    }
    button:nth-child(6) {
      grid-column: span 1;
    }
  }
</style>
