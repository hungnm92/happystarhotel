---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { asset } from '../lib/images';
import { channels } from '../lib/cta';
import { contact, links } from '../data/contact';
import { minPrice } from '../data/rooms';
import { formatPrice, type Locale } from '../i18n';
import type { Dict } from '../i18n/vi';

interface Props {
  locale: Locale;
  t: Dict;
}

const { locale, t } = Astro.props;
const primary = channels(t)[0];
---

<section class="hero">
  <Image
    class="banner"
    src={asset('hotel/banner.webp')}
    alt={t.hero.bannerAlt}
    widths={[800, 1200, 1600, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <div class="container bar">
    <div class="copy">
      <h1><span class="brand">{contact.name}</span>{t.hero.title}</h1>
      <p class="lead">{t.hero.lead}</p>
      <p class="address">
        <Icon name="pin" size={18} />
        {contact.address.full}
      </p>
    </div>

    <div class="offer">
      <p class="price">
        <span>{t.hero.priceFrom}</span>
        <strong>{formatPrice(locale, minPrice)}</strong>
        <span>{t.hero.perNight}</span>
      </p>
      <div class="actions">
        <a class="btn btn-sun" href={primary.href} target="_blank" rel="nofollow noopener" data-cta={`hero-${primary.key}`}>
          <Icon name={primary.icon} />
          {t.hero.cta(primary.label)}
        </a>
        <a class="btn btn-line" href={links.tel} data-cta="hero-call">
          <Icon name="phone" size={20} />
          {contact.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(180deg, var(--white) 0%, var(--foam) 100%);
  }

  /* Banner chính thức của khách sạn, giữ nguyên tỉ lệ 3:1 */
  .banner {
    display: block;
    width: 100%;
    max-width: 2000px;
    height: auto;
    margin-inline: auto;
  }

  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: clamp(1.75rem, 4vw, 3rem);
  }

  .copy {
    display: grid;
    gap: 0.75rem;
  }

  h1 {
    font-size: var(--step-3);
    font-weight: 900;
    color: var(--ink);
    max-width: 22ch;
  }

  .brand {
    display: block;
    margin-bottom: 0.4rem;
    font-size: var(--step-0);
    font-weight: 800;
    color: var(--sea);
  }

  .lead {
    line-height: 1.55;
    color: var(--muted);
    max-width: 36rem;
  }

  .address {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .offer {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--white);
    border: 2px solid var(--foam);
    border-radius: var(--radius);
  }

  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-weight: 700;
    color: var(--muted);
  }

  .price strong {
    font-size: var(--step-3);
    font-weight: 900;
    color: var(--sea);
    letter-spacing: -0.02em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .actions .btn {
    min-height: 54px;
    padding-inline: 1.5rem;
    font-size: 1.05rem;
  }

  @media (max-width: 860px) {
    .bar {
      grid-template-columns: 1fr;
      padding-top: 1.25rem;
    }
    h1 {
      font-size: var(--step-2);
    }
    .actions,
    .actions .btn {
      width: 100%;
    }
  }
</style>
