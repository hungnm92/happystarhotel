---
import Icon from './Icon.astro';
import { contact } from '../data/contact';
import type { Dict } from '../i18n/vi';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const a = t.amenities;
// Icon theo đúng thứ tự danh sách trong file ngôn ngữ
const inRoomIcons = ['wifi', 'snow', 'tv', 'fridge', 'mirror', 'shower', 'towel'] as const;
const serviceIcons = ['coffee', 'shirt', 'sun', 'chef', 'bike', 'elevator', 'clock'] as const;
---

<section class="section" id="amenities">
  <div class="container">
    <div class="section-head">
      <h2>{a.title}</h2>
    </div>

    <div class="grid">
      <div class="block">
        <h3>{a.inRoomTitle}</h3>
        <ul class="list">
          {a.inRoom.map((item, i) => <li><Icon name={inRoomIcons[i] ?? 'check'} />{item}</li>)}
        </ul>
      </div>

      <div class="block">
        <h3>{a.servicesTitle}</h3>
        <ul class="list">
          {a.services.map((item, i) => <li><Icon name={serviceIcons[i] ?? 'check'} />{item}</li>)}
        </ul>
      </div>

      <aside class="block practical">
        <h3>{a.practicalTitle}</h3>
        <dl>
          <div>
            <dt>{a.checkIn}</dt>
            <dd>{contact.checkIn}</dd>
          </div>
          <div>
            <dt>{a.checkOut}</dt>
            <dd>{contact.checkOut}</dd>
          </div>
        </dl>
        <p><Icon name="baby" />{a.kids}</p>
        <p><Icon name="group" />{a.groups}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1.1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .block h3 {
    margin-bottom: 1rem;
  }

  .list {
    display: grid;
    gap: 0.15rem;
  }

  .list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }

  .list :global(svg) {
    flex: none;
    color: var(--sea);
  }

  .practical {
    align-self: start;
    display: grid;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: var(--radius);
    background: var(--foam);
  }

  .practical h3 {
    margin-bottom: 0;
  }

  dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin: 0;
  }

  dl div {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--white);
  }

  dt {
    font-size: var(--step--1);
    color: var(--muted);
  }

  dd {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 900;
    color: var(--sea);
  }

  .practical p {
    display: flex;
    gap: 0.6rem;
    font-weight: 700;
  }

  .practical p :global(svg) {
    flex: none;
    color: var(--sun-deep);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .practical {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
