---
import RoomCard from './RoomCard.astro';
import { rooms } from '../data/rooms';
import type { Locale } from '../i18n';
import type { Dict } from '../i18n/vi';

interface Props {
  locale: Locale;
  t: Dict;
}

const { locale, t } = Astro.props;
const tiers = (['window', 'balcony'] as const).map((tier) => ({
  tier,
  title: t.rooms.tiers[tier],
  rooms: rooms.filter((r) => r.tier === tier),
}));
---

<section class="section rooms" id="rooms">
  <div class="container">
    <div class="section-head">
      <h2>{t.rooms.title}</h2>
      <p>{t.rooms.lead}</p>
    </div>

    {
      tiers.map((group) => (
        <div class="tier">
          <h3 class="tier-title">{group.title}</h3>
          <div class="grid">
            {group.rooms.map((room) => (
              <RoomCard room={room} locale={locale} t={t} />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .rooms {
    background: var(--lilac);
  }

  .tier + .tier {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .tier-title {
    margin-bottom: 1.25rem;
    font-size: var(--step-1);
    color: var(--sea);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  /* Thẻ lẻ cuối cùng trải ngang 2 cột */
  @media (min-width: 761px) {
    .grid > :global(.card:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-rows: auto;
    }
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
